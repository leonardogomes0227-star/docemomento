rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa pode ver o cardápio; só quem está na lista abaixo pode alterar.
    match /produtos/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['EMAIL_DA_ANA@exemplo.com', 'EMAIL_DO_DONO@exemplo.com'];
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
